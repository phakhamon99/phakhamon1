    <script>
        // Theme Toggle Functionality
        function toggleTheme() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                html.classList.add('light');
                themeIcon.className = 'fa-solid fa-sun text-amber-400 text-lg';
            } else {
                html.classList.remove('light');
                html.classList.add('dark');
                themeIcon.className = 'fa-solid fa-moon text-lg';
            }
        }

        // Project Filtering
        function filterProjects(category) {
            const cards = document.querySelectorAll('.project-card');
            const buttons = document.querySelectorAll('.filter-btn');

            buttons.forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white', 'shadow-md');
                btn.classList.add('bg-slate-800', 'text-slate-300');
            });

            event.currentTarget.classList.remove('bg-slate-800', 'text-slate-300');
            event.currentTarget.classList.add('bg-blue-600', 'text-white', 'shadow-md');

            cards.forEach(card => {
                const cardCat = card.getAttribute('data-category');
                if (category === 'all' || cardCat.includes(category)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // File Location Alert / Helper
        function showFileLocation(filename) {
            showToast(`ไฟล์ท้องถิ่น: file:///C:/Users/ACER/Downloads/${filename}`);
        }

        // Toast Notification Helper
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            toastMsg.innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        // Contact Form Submission
        function handleContactSubmit(e) {
            e.preventDefault();
            showToast('ขอบคุณสำหรับการติดต่อ! ข้อความถูกส่งแล้ว');
            e.target.reset();
        }

        // --- BMI CALCULATOR LOGIC ---
        function openBmiModal() {
            document.getElementById('bmiModal').classList.remove('hidden');
        }

        function closeBmiModal() {
            document.getElementById('bmiModal').classList.add('hidden');
        }

        function calculateBMI() {
            const height = parseFloat(document.getElementById('bmiHeight').value);
            const weight = parseFloat(document.getElementById('bmiWeight').value);
            const resultBox = document.getElementById('bmiResultBox');

            if (!height || !weight || height <= 0 || weight <= 0) {
                alert('กรุณากรอกส่วนสูงและน้ำหนักให้ถูกต้อง');
                return;
            }

            const bmi = weight / ((height / 100) ** 2);
            const formattedBmi = bmi.toFixed(1);

            document.getElementById('bmiValue').innerText = formattedBmi;

            let status = '';
            let advice = '';
            let colorClass = 'text-emerald-400';

            if (bmi < 18.5) {
                status = 'น้ำหนักน้อย / ผอม';
                advice = 'ควรรับประทานอาหารให้ครบ 5 หมู่ และเพิ่มปริมาณแคลอรีอย่างเหมาะสม';
                colorClass = 'text-sky-400';
            } else if (bmi < 23) {
                status = 'สมส่วน / ปกติ';
                advice = 'สุขภาพดีเยี่ยม! ควบคุมอาหารและออกกำลังกายสม่ำเสมอต่อไป';
                colorClass = 'text-emerald-400';
            } else if (bmi < 25) {
                status = 'น้ำหนักเกิน (ท้วม)';
                advice = 'เริ่มมีความเสี่ยง ควบคุมปริมาณแป้งและน้ำตาล';
                colorClass = 'text-amber-400';
            } else {
                status = 'อ้วน / เสี่ยงโรค';
                advice = 'ควรลดการบริโภคของหวาน ของมัน และเพิ่มการออกกำลังกาย';
                colorClass = 'text-rose-400';
            }

            document.getElementById('bmiStatus').innerText = status;
            document.getElementById('bmiValue').className = `text-3xl font-extrabold ${colorClass}`;
            document.getElementById('bmiAdvice').innerText = advice;

            resultBox.classList.remove('hidden');
        }

        // --- CYBER ARCADE MINI GAME LOGIC ---
        let gameTimer = null;
        let score = 0;
        let timeLeft = 15;
        let target = { x: 0, y: 0, radius: 25 };

        function openArcadeModal() {
            document.getElementById('arcadeModal').classList.remove('hidden');
            initCanvas();
        }

        function closeArcadeModal() {
            document.getElementById('arcadeModal').classList.add('hidden');
            clearInterval(gameTimer);
        }

        function initCanvas() {
            const canvas = document.getElementById('arcadeCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;

            // Simple Grid Background
            ctx.fillStyle = '#0a0d18';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }

        function startArcadeGame() {
            score = 0;
            timeLeft = 15;
            document.getElementById('arcadeScore').innerText = score;
            document.getElementById('arcadeTimer').innerText = timeLeft;
            document.getElementById('arcadeOverlay').classList.add('hidden');

            const canvas = document.getElementById('arcadeCanvas');
            canvas.onclick = handleCanvasClick;

            spawnTarget();
            
            clearInterval(gameTimer);
            gameTimer = setInterval(() => {
                timeLeft--;
                document.getElementById('arcadeTimer').innerText = timeLeft;
                if (timeLeft <= 0) {
                    endArcadeGame();
                }
            }, 1000);
        }

        function spawnTarget() {
            const canvas = document.getElementById('arcadeCanvas');
            const ctx = canvas.getContext('2d');

            target.radius = Math.floor(Math.random() * 15) + 18;
            target.x = Math.random() * (canvas.width - target.radius * 2) + target.radius;
            target.y = Math.random() * (canvas.height - target.radius * 2) + target.radius;

            drawTarget();
        }

        function drawTarget() {
            const canvas = document.getElementById('arcadeCanvas');
            const ctx = canvas.getContext('2d');

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Background Grid
            ctx.strokeStyle = 'rgba(255,0,127,0.1)';
            ctx.lineWidth = 1;
            for(let x=0; x<canvas.width; x+=30) {
                ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,canvas.height); ctx.stroke();
            }

            // Target Outer Ring
            ctx.beginPath();
            ctx.arc(target.x, target.y, target.radius, 0, Math.PI * 2);
            ctx.strokeStyle = '#ff007f';
            ctx.lineWidth = 3;
            ctx.shadowBlur = 15;
            ctx.shadowColor = '#ff007f';
            ctx.stroke();

            // Target Inner Ring
            ctx.beginPath();
            ctx.arc(target.x, target.y, target.radius * 0.5, 0, Math.PI * 2);
            ctx.fillStyle = '#00f3ff';
            ctx.shadowBlur = 10;
            ctx.shadowColor = '#00f3ff';
            ctx.fill();
        }

        function handleCanvasClick(e) {
            const canvas = document.getElementById('arcadeCanvas');
            const rect = canvas.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const clickY = e.clientY - rect.top;

            const dist = Math.hypot(clickX - target.x, clickY - target.y);
            if (dist <= target.radius) {
                score += 10;
                document.getElementById('arcadeScore').innerText = score;
                spawnTarget();
            }
        }

        function endArcadeGame() {
            clearInterval(gameTimer);
            const canvas = document.getElementById('arcadeCanvas');
            canvas.onclick = null;

            const overlay = document.getElementById('arcadeOverlay');
            overlay.innerHTML = `
                <i class="fa-solid fa-trophy text-4xl text-amber-400"></i>
                <h4 class="text-xl font-bold text-white">หมดเวลา!</h4>
                <p class="text-sm text-slate-300">คะแนนรวมที่คุณทำได้: <span class="text-pink-400 font-bold text-lg">${score}</span> คะแนน</p>
                <button onclick="startArcadeGame()" class="px-6 py-2 rounded-xl bg-pink-600 text-white text-xs font-medium">เล่นใหม่อีกครั้ง</button>
            `;
            overlay.classList.remove('hidden');
        }
    </script>
</body>
</html>
